# SAP Business One Configuration
SAP_B1_SERVICE_LAYER_URL=https://your-server:50000/b1s/v1
SAP_B1_COMPANY_DB=SBODEMOUS
SAP_B1_USERNAME=manager
SAP_B1_PASSWORD=your_password

# Forecasting Configuration
FORECAST_HORIZON_DAYS=2
HISTORICAL_DATA_DAYS=365
MIN_HISTORICAL_RECORDS=30
CONFIDENCE_INTERVAL=0.95

# Prophet Model Parameters
PROPHET_CHANGEPOINT_PRIOR_SCALE=0.05
PROPHET_SEASONALITY_PRIOR_SCALE=10
PROPHET_HOLIDAYS_PRIOR_SCALE=10
PROPHET_SEASONALITY_MODE=multiplicative
PROPHET_WEEKLY_SEASONALITY=true
PROPHET_YEARLY_SEASONALITY=true
PROPHET_DAILY_SEASONALITY=false

# Business Logic Parameters
# Stockout indicator: if returns are 0% and sales > threshold, increase order
STOCKOUT_SALES_THRESHOLD=0.8
STOCKOUT_MULTIPLIER=1.3

# Overstock indicator: if returns > threshold, decrease order
OVERSTOCK_RETURN_THRESHOLD=0.15
OVERSTOCK_MULTIPLIER=0.7

# Safety stock percentage
SAFETY_STOCK_PERCENTAGE=0.1

# Minimum order quantity
MIN_ORDER_QUANTITY=1

# Regional Settings
TIMEZONE=Asia/Riyadh
LOCALE=en-US

# Scheduling
FORECAST_GENERATION_TIME=06:00
ENABLE_SCHEDULER=true

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs/forecaster.log

# Output
OUTPUT_FORMAT=xlsx
OUTPUT_PATH=./data/output

# Special Events Configuration
BACK_TO_SCHOOL_START_MONTH=8
BACK_TO_SCHOOL_START_DAY=15
BACK_TO_SCHOOL_DURATION_DAYS=30

# Ramadan - Calculate dynamically (Islamic calendar) but can override
# RAMADAN_START_DATE=2025-03-01
# RAMADAN_END_DATE=2025-03-30

# Eid al-Adha - Calculate dynamically (Islamic calendar) but can override
# EID_ADHA_START_DATE=2025-06-15
# EID_ADHA_DURATION_DAYS=4

# Odoo Integration (Optional)
ODOO_ENABLED=false
ODOO_URL=https://your-odoo-server.com
ODOO_DB=your_odoo_database
ODOO_USERNAME=your_odoo_user
ODOO_PASSWORD=your_odoo_password

# Odoo Default Salesman ID (fallback if customer has no assigned salesman)
ODOO_DEFAULT_SALESMAN_ID=2

# Auto-confirm orders in Odoo after creation
ODOO_AUTO_CONFIRM_ORDERS=false

# Create transfer/picking requests automatically
ODOO_CREATE_TRANSFER_REQUESTS=false
